# Copy to .env (make up does it automatically) and adjust if needed.
# Comments must stay on their own lines.

# --- General ---
# dev | prod: selects config.settings.<ENV>
ENV=dev
SITE_URL=http://localhost:8080
SECRET_KEY=change-me
DEBUG=1
# "backend" is the host Next.js uses for server-side requests inside Docker
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# --- Database and cache ---
POSTGRES_DB=blockcraft
POSTGRES_USER=blockcraft
POSTGRES_PASSWORD=blockcraft
DATABASE_URL=postgres://blockcraft:blockcraft@db:5432/blockcraft
REDIS_URL=redis://redis:6379/0

# --- Search ---
MEILI_URL=http://meili:7700
MEILI_MASTER_KEY=change-me-to-a-key-of-16-chars-or-more

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=BlockCraft <no-reply@example.com>

# --- OAuth (stage 2) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- External APIs (stage 3) ---
# Modrinth requires a unique User-Agent with contact info
MODRINTH_USER_AGENT=blockcraft-ua/1.0 (contact: you@example.com)
MODRINTH_SYNC_LIMIT_MODS=300

# --- Frontend ---
NEXT_PUBLIC_SITE_URL=http://localhost:8080
INTERNAL_API_URL=http://backend:8000
# Where Nginx proxies the frontend: frontend:3000 (Docker)
# or host.docker.internal:3000 (pnpm dev on the host, see README)
FRONTEND_UPSTREAM=frontend:3000

# --- S3 (stage 11) ---
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
