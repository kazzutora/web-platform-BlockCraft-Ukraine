{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(docker compose *)",
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(pnpm *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git show *)",
      "Bash(ls *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(docker compose down -v *)",
      "Bash(make reset-db *)",
      "Bash(uv add *)",
      "Bash(pnpm add *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.prod)",
      "Read(./backend/.env)",
      "Read(./frontend/.env.local)",
      "Bash(git push --force *)",
      "Bash(rm -rf *)"
    ]
  }
}
